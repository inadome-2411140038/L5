<h1>ユーザ登録</h1>

<%= form_with model: @user do |f| %>
  <p>
    <%= f.label :uid, "ユーザID" %>
    <%= f.text_field :uid %>
  </p>

  <p>
    <%= f.label :password, "パスワード" %>
    <%= f.text_field :password %>
  </p>

  <p>
    <%= f.label :password_confirmation, "パスワード（確認）" %>
    <%= f.text_field :password_confirmation %>
  </p>

  <%= f.submit "登録" %>
<% end %>

<p>
  <%= link_to "ユーザ一覧", users_path %>
</p>

<p>
  <%= link_to "トップへ戻る", root_path %>
</p>